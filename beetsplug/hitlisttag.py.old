import mediafile
from beets.dbcore.types import T, N
from beets.plugins import BeetsPlugin
from beets.dbcore import types
from mediafile import (MediaField, ListMediaField, MP3DescStorageStyle, MP3ListDescStorageStyle, MP4StorageStyle,
                       MP4ListStorageStyle, StorageStyle, ListStorageStyle)
from typing import List, Dict, Union, Any, cast
import json


def _collapse_years(years: list[int]) -> str:
    prev = None  # previous in list
    last = None  # last written
    in_range = False
    out = ""
    for m in years:
        if last is None:  # first digit
            last = m
            out = out + str(m)
        elif in_range:
            if m != prev + 1:  # end range
                out = out + "-" + str(prev) + " / " + str(m)
                in_range = False
        else:
            if m == prev + 1:  # start range
                in_range = True
            else:
                out = out + " / " + str(m)

        prev = m
    if in_range:
        out = out + "-" + str(prev)
    return out


# fields:
#  - MY_SONG_ID
#  - TOP2000: list of years
#  - TOP2000_score: int
#  - TOP2000_charts: list of year:position
#  - TOP2000_highest: highest position in Top 2000

# Same for TOP100, TOP40, ZWAARSTELIJST except

#  - TOP40_charts: list of year:{week: position; dict} == json.dumps(k,v)

# T type, N nulltype

type yearlist = list[int]

class YearList(types.Type[yearlist, None]):
    model_type = yearlist

    def __init__(self):
        self.delimiter = "\\␀"

    def format(self, value: Union[yearlist, None]) -> str:
        # unicode representing the value in template evaluation
        if value is None:
            return "<no entries>"
        out = _collapse_years([int(v) for v in value])
        return out

    def parse(self, string: str) -> Union[yearlist, None]:
        # parse string from database
        if not string:
            return self.null
        out = [int(year) for year in string.split(self.delimiter)]
        return out

    def to_sql(self, model_value: yearlist) -> str:
        if model_value is None:
            return ""
        out = self.delimiter.join([str(v) for v in model_value])
        return out

    def normalize(self, value: Any) -> Union[yearlist, None]:
        if value is None:
            return self.null
        out = [int(v) for v in value]
        return out


    def from_sql(
            self,
            sql_value: Union[None, int, float, str, bytes] ) -> Union[yearlist, None]:
        print(f"VALUE/YearList/fromsql/in ({type(sql_value)}) : {sql_value}")
        if isinstance(sql_value, memoryview):
            sql_value = bytes(sql_value).decode("utf-8", "ignore")
        if isinstance(sql_value, str):
            out =  self.parse(sql_value)
        else:
            out =  self.normalize(sql_value)
        print(f"NORM/YearList/fromsql/out ({type(out)}): {out}")

        return out

    @property
    def null(self):
        return None


type chart = dict[int, dict[int, int]]


class Chart(types.Type[chart, None]):
    model_type = chart

    def __init__(self):
        self.delimiter = "\\␀"

    def format(self, value: Union[chart, None]) -> str:
        # unicode representing the value in template evaluation
        if value is None:
            return "<no entries>"
        out = json.dumps(value)
        return out

    def parse(self, string: str) -> Union[chart, None]:
        # parse string from database
        if not string:
            return self.null
        out = { int(x[0]):json.loads(x[1]) for x in [s.split(':', maxsplit=1) for s in string.split(self.delimiter)]}
        return out

    def normalize(self, value: Any) -> Union[yearlist, None]:
        if value is None:
            return self.null
        if isinstance(value, str):
            out = { int(x[0]):json.loads(x[1]) for x in [s.split(':', maxsplit=1) for s in value.split(self.delimiter)]}
        elif isinstance(value, list):
            out = { int(x[0]):json.loads(x[1]) for x in [s.split(':', maxsplit=1) for s in value]}
        return out


    def to_sql(self, model_value: chart):
        out = self.delimiter.join(
            [f"{k}:{json.dumps(v)}" for k, v in model_value.items()]
        )
        return out

    @property
    def null(self):
        return None


YEARLIST = YearList()
CHART = Chart()
NULLINTEGER = types.NullInteger()


